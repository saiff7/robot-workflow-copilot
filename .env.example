# .env.example — copy to .env and fill in as needed.
# The application runs correctly with NO .env file at all: every setting
# below has a safe default (see app/config.py), and GEMINI_API_KEY being
# unset simply means the parser always uses the deterministic fallback path.

# Optional: enables the Gemini-backed parser. Leave unset to always use the
# deterministic regex fallback parser (the demo works fully either way).
GEMINI_API_KEY=

# Optional: which Gemini model to call if GEMINI_API_KEY is set.
GEMINI_MODEL=gemini-2.0-flash

# Optional: seconds to wait for a Gemini response before falling back.
LLM_TIMEOUT_SECONDS=8.0

# Where the SQLite event log is stored. Relative to the container/working
# directory; the parent directory is created automatically if missing.
DATABASE_PATH=data/events.db

# Optional: if set, a matching X-API-Key header is required on /api/* routes.
# Leave unset to leave the API open (fine for local/demo use).
API_KEY=

# Standard Python logging level for the JSON-formatted structured logs.
LOG_LEVEL=INFO

# Optional: fixes the RNG seed used by the simulator's stochastic failure
# model, for a fully reproducible demo recording. Leave unset for varied
# runs.
FAILURE_INJECTION_SEED=
